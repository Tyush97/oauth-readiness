# Free key from https://aistudio.google.com/apikey (no card needed). Never commit the real value.
GEMINI_API_KEY=
# Optional. Comma-separated Gemini models ; later ones are fallbacks on 404/429.
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
# Optional. Set to 1 to stream a canned guide without calling the model (UI development).
MOCK_GENERATION=
